{{> head}}
<main class="flex flex-1 items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="mb-6 text-center">
      <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand text-xl font-extrabold text-white">MF</span>
      <h1 class="mt-4 text-2xl font-extrabold">MindaFresh POS</h1>
      <p class="text-ink-muted">Point of Sale · Inventory · Purchasing</p>
    </div>
    {{> flash}}
    <form action="/login" method="POST" class="card space-y-4 p-6">
      <div>
        <label for="username" class="label">Username</label>
        <input id="username" name="username" class="field mt-1" autocomplete="username" required autofocus>
      </div>
      <div>
        <label for="password" class="label">Password</label>
        <input id="password" name="password" type="password" class="field mt-1" autocomplete="current-password" required>
      </div>
      <button class="btn-primary w-full">Log in</button>
      <p class="text-center text-sm text-ink-muted">Same staff account as HR, Attendance and Accounting.</p>
    </form>
  </div>
</main>
{{> footer}}
