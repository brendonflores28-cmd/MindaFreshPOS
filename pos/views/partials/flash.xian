{{#each success_msg}}<div class="mb-4 rounded-xl border border-[#C9DFA9] bg-leaf-bg px-4 py-3 font-semibold text-leaf print:hidden">{{this}}</div>{{/each}}
{{#each error_msg}}<div class="mb-4 rounded-xl border border-[#E3B3A8] bg-danger-bg px-4 py-3 font-semibold text-danger print:hidden">{{this}}</div>{{/each}}
